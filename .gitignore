# Raw data is excluded on purpose: it is the untouched source extract and
# shouldn't be committed. Processed output is regenerated by src/main.py.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
